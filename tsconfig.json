{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": [
            "node"
        ]
    },
    // pos-offline est un sous-projet Vite autonome avec son propre tsconfig (JSX).
    "exclude": [
        "pos-offline",
        "node_modules",
        "out",
        "release"
    ]
}